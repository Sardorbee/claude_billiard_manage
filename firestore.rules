rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The caller's own profile. Fails (and so denies) if they have none.
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function inVenue(venueId) {
      return signedIn() && me().venueId == venueId
        && me().get('isActive', true) != false;
    }

    function isManager(venueId) {
      return inVenue(venueId) && me().role in ['manager', 'owner'];
    }

    // Mirrors AppUser.canVoid / canApplyDiscount: everyone except plain staff.
    function canOverride(venueId) {
      return inVenue(venueId) && me().role in ['supervisor', 'manager', 'owner'];
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ── Staff profiles ──────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || isManager(resource.data.venueId));

      // Managers add staff to their own venue; only an owner can add an owner.
      allow create: if isManager(request.resource.data.venueId)
        && (request.resource.data.role != 'owner' || me().role == 'owner');

      // Anyone may stamp their own lastLogin; everything else is a manager's
      // call, and nobody can be moved to another venue.
      allow update: if signedIn() && (
        (request.auth.uid == uid && changedOnly(['lastLogin']))
        || (isManager(resource.data.venueId)
            && request.resource.data.venueId == resource.data.venueId
            && (request.resource.data.role != 'owner' || me().role == 'owner'))
      );

      allow delete: if false;
    }

    // ── Venue data ──────────────────────────────────────────────────────
    match /venues/{venueId} {
      allow read: if inVenue(venueId);
      // isManager ties the caller to this venue id, so "create" only ever
      // fills in the document for a venue they already manage.
      allow create, update: if isManager(venueId);
      allow delete: if false;

      match /tables/{tableId} {
        allow read: if inVenue(venueId);
        allow create, delete: if isManager(venueId);
        // Staff only move a table between open / active / reserved; name,
        // price and the rest belong to managers.
        allow update: if isManager(venueId)
          || (inVenue(venueId)
              && changedOnly(['status', 'currentSessionId', 'reservationId',
                              'sessionEndsAt']));
      }

      match /sessions/{sessionId} {
        allow read: if inVenue(venueId);
        // A table session starts active; a counter sale (no table) is
        // written already completed.
        allow create: if inVenue(venueId)
          && request.resource.data.openedBy == request.auth.uid
          && (request.resource.data.status == 'active'
              || (request.resource.data.status == 'completed'
                  && request.resource.data.tableId == ''));
        // A closed session is history: nobody edits it afterwards. Staff run
        // the session but cannot discount or void it.
        allow update: if inVenue(venueId) && resource.data.status == 'active'
          && (canOverride(venueId)
              || (request.resource.data.status != 'voided'
                  && request.resource.data.get('discount', 0)
                      == resource.data.get('discount', 0)));
        allow delete: if false;
      }

      match /menu/{itemId} {
        allow read: if inVenue(venueId);
        allow write: if isManager(venueId);
      }

      // Balances move with every debt and payment, so all staff write them.
      match /customers/{customerId} {
        allow read, create, update: if inVenue(venueId);
        allow delete: if false;
      }

      // The ledger is append-only. Anyone on staff records a payment or a
      // debt that comes from a sale; a debt typed in by hand or a write-off
      // needs someone above staff.
      match /debtEntries/{entryId} {
        allow read: if inVenue(venueId);
        allow create: if inVenue(venueId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.amount > 0
          && (request.resource.data.type == 'payment'
              || (request.resource.data.type == 'debt'
                  && request.resource.data.sessionId != null)
              || canOverride(venueId));
        allow update, delete: if false;
      }

      // The owner's record of sensitive actions. Staff actions are written
      // to it, but only those above staff can read it, and nobody can
      // change or remove an entry.
      match /activity/{entryId} {
        allow read: if canOverride(venueId);
        allow create: if inVenue(venueId)
          && request.resource.data.byUid == request.auth.uid;
        allow update, delete: if false;
      }

      // Staff record what was spent (so the cash adds up); only someone
      // above staff can remove an entry, and nobody edits one.
      match /expenses/{expenseId} {
        allow read: if inVenue(venueId);
        allow create: if inVenue(venueId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.amount > 0;
        allow update: if false;
        allow delete: if canOverride(venueId);
      }

      match /bookings/{bookingId} {
        allow read, write: if inVenue(venueId);
      }
    }
  }
}
